# Copy this file to .env and add your key. Never commit a real API key.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional: override the default models (change these if Google renames or retires a model)
GEMINI_RAG_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_RAG_CHAT_MODEL=gemini-3.5-flash
